{
  "name": "home-energy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "node scripts/prepare-cloudflare.mjs && opennextjs-cloudflare build",
    "ci:cloudflare": "npm run typecheck && npm test && npm run build:worker && npm run check:worker",
    "check:worker": "node scripts/check-worker.mjs",
    "deploy:worker": "opennextjs-cloudflare deploy",
    "preview:worker": "opennextjs-cloudflare preview",
    "upload:worker": "opennextjs-cloudflare upload",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:api": "node scripts/generate-api.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.10",
    "bcryptjs": "3.0.2",
    "jose": "6.1.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "overrides": {
    "@node-minify/core": { "glob": "10.5.0" }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.0",
    "vitest": "5.0.3",
    "wrangler": "4.150.0"
  }
}
