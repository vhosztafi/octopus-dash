{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "octopus-dash",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS", "html_handling": "none" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "octopus-dash" }],
  "routes": [{ "pattern": "octopus-dash.vilmos.co.uk", "custom_domain": true }],
  "vars": {
    "API_BASE_URL": "https://octopus-dash-api.vilmos.co.uk",
    "DEPLOYMENT_TARGET": "cloudflare"
  },
  "ratelimits": [{
    "name": "LOGIN_RATE_LIMITER",
    "namespace_id": "2610134371",
    "simple": { "limit": 10, "period": 60 }
  }],
  "observability": { "enabled": true }
}
